# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Database Configuration
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/whatsapp_task_manager?schema=public"

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Matrix/Beeper Configuration for WhatsApp Bridge
# Get these credentials from your Beeper account settings
# 1. Set up bbctl: https://github.com/beeper/bridge-manager
# 2. Run: bbctl run sh-whatsapp
# 3. Get your access token from Beeper settings
MATRIX_HOMESERVER_URL="https://matrix.beeper.com"
MATRIX_USER_ID="@your-username:beeper.com"
MATRIX_ACCESS_TOKEN="your_beeper_access_token_here"
MATRIX_DEVICE_ID="your_device_id"

# WhatsApp API (alternative to Matrix bridge - not currently used)
# WHATSAPP_API_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# AI/LLM for message analysis (e.g., OpenAI)
OPENAI_API_KEY=""

# File Storage (e.g., AWS S3, Cloudinary)
STORAGE_PROVIDER="s3" # or "cloudinary"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
AWS_REGION=""

# Example:
# SERVERVAR="foo"
# NEXT_PUBLIC_CLIENTVAR="bar"
