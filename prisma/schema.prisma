// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Manager - Users with Clerk authentication who manage everything
model Manager {
  id          String   @id @default(cuid())
  clerkId     String   @unique
  email       String   @unique
  name        String?
  phoneNumber String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  projects            Project[]
  createdUsers        AssignedUser[]
  createdTasks        Task[]
  conversationMembers ConversationMember[]

  @@map("managers")
}

// Project - Garden, builds, or any work project
model Project {
  id          String   @id @default(cuid())
  managerId   String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  manager       Manager        @relation(fields: [managerId], references: [id], onDelete: Cascade)
  assignedUsers AssignedUser[]
  tasks         Task[]

  @@index([managerId])
  @@map("projects")
}

// AssignedUser - Workers created by manager, linked to projects, no Clerk account
model AssignedUser {
  id          String   @id @default(cuid())
  projectId   String
  managerId   String // Who created this user
  name        String
  phoneNumber String // WhatsApp number
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  manager             Manager              @relation(fields: [managerId], references: [id], onDelete: Cascade)
  tasks               Task[]
  taskUpdates         TaskUpdate[]
  conversationMembers ConversationMember[]

  @@unique([projectId, phoneNumber]) // Each phone number is unique per project
  @@index([projectId])
  @@index([managerId])
  @@map("assigned_users")
}

// Conversation - WhatsApp groups or personal chats
model Conversation {
  id                     String           @id @default(cuid())
  whatsappConversationId String           @unique // WhatsApp's conversation ID
  name                   String?
  type                   ConversationType @default(PERSONAL)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  // Relations
  members   ConversationMember[]
  tasks     Task[]
  reminders Reminder[]

  @@map("conversations")
}

enum ConversationType {
  PERSONAL
  GROUP
}

// ConversationMember - Join table for who's in which conversation
model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  assignedUserId String? // Null if it's a manager
  managerId      String? // Null if it's an assigned user
  joinedAt       DateTime @default(now())

  // Relations
  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  assignedUser AssignedUser? @relation(fields: [assignedUserId], references: [id], onDelete: Cascade)
  manager      Manager?      @relation(fields: [managerId], references: [id], onDelete: Cascade)

  @@unique([conversationId, assignedUserId])
  @@unique([conversationId, managerId])
  @@index([conversationId])
  @@map("conversation_members")
}

// Task - Work to be done
model Task {
  id                 String      @id @default(cuid())
  projectId          String
  assignedUserId     String
  managerId          String // Creator
  conversationId     String // Where this task is discussed
  title              String
  description        String?
  status             TaskStatus  @default(TODO)
  priority           TaskPriority @default(MEDIUM)
  dueDate            DateTime?
  whatsappMessageId  String?     @unique // Original bot message ID that announced this task
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  completedAt        DateTime?

  // Relations
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedUser   AssignedUser     @relation(fields: [assignedUserId], references: [id], onDelete: Cascade)
  manager        Manager          @relation(fields: [managerId], references: [id], onDelete: Cascade)
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  updates        TaskUpdate[]
  attachments    TaskAttachment[]
  reminders      Reminder[]

  @@index([projectId])
  @@index([assignedUserId])
  @@index([managerId])
  @@index([conversationId])
  @@index([status])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
  FEEDBACK_NEEDED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// TaskUpdate - WhatsApp messages sent by assigned users in response to tasks
model TaskUpdate {
  id                String      @id @default(cuid())
  taskId            String
  assignedUserId    String
  whatsappMessageId String      @unique // WhatsApp message ID
  messageText       String?
  messageType       MessageType @default(TEXT)
  analyzedByAI      Boolean     @default(false)
  aiAnalysis        Json?       // What the AI understood from the message
  createdAt         DateTime    @default(now())

  // Relations
  task         Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignedUser AssignedUser     @relation(fields: [assignedUserId], references: [id], onDelete: Cascade)
  attachments  TaskAttachment[]

  @@index([taskId])
  @@index([assignedUserId])
  @@index([createdAt])
  @@map("task_updates")
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  DOCUMENT
}

// TaskAttachment - Files/media sent via WhatsApp
model TaskAttachment {
  id               String   @id @default(cuid())
  taskUpdateId     String
  taskId           String
  fileName         String
  fileType         String
  fileSize         Int?
  storageUrl       String // URL where the file is stored
  mimeType         String?
  whatsappMediaId  String? // WhatsApp's media ID
  createdAt        DateTime @default(now())

  // Relations
  taskUpdate TaskUpdate @relation(fields: [taskUpdateId], references: [id], onDelete: Cascade)
  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskUpdateId])
  @@index([taskId])
  @@map("task_attachments")
}

// Reminder - Configuration for task reminders
model Reminder {
  id             String            @id @default(cuid())
  taskId         String
  conversationId String // Where to send the reminder
  frequency      ReminderFrequency @default(ONCE)
  nextReminderAt DateTime?
  lastSentAt     DateTime?
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // Relations
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([conversationId])
  @@index([nextReminderAt, isActive])
  @@map("reminders")
}

enum ReminderFrequency {
  ONCE
  DAILY
  WEEKLY
  CUSTOM
}
